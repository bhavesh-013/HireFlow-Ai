          "raw": "{\n  \"name\": \"Alex Mercer\",\n  \"headline\": \"Senior Full Stack Engineer & AI Specialist\",\n  \"bio\": \"Passionate developer building AI-powered career tools.\",\n  \"skills\": [\"React\", \"Node.js\", \"Express\", \"MongoDB\", \"TypeScript\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "profile"]
        },
        "description": "Update profile details for current user."
      },
      "response": []
