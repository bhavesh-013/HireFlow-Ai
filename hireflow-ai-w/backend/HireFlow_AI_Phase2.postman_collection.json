    {
      "name": "4. Version History",
      "item": [
        {
          "name": "Create Manual Snapshot Version",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('versionId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pre-Interview Revision\",\n  \"notes\": \"Updated work history bullet points before Google application submission.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}/version",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", "{{resumeId}}", "version"]
            }
          }
        },
        {
          "name": "Get Version History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", "{{resumeId}}", "history"]
            }
          }
        },
        {
          "name": "Restore Version Snapshot",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}/version/{{versionId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", "{{resumeId}}", "version", "{{versionId}}", "restore"]
            }
          }
        },
        {
          "name": "Delete Version Snapshot",
          "request": {
            "method": "DELETE",
            "header": [
