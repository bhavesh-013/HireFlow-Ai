{
  "info": {
    "_postman_id": "b9f4e2c3-5d01-5f23-9b01-hireflowai02",
    "name": "HireFlow AI - Phase 2 Resume Management API",
    "description": "Complete Postman Collection for HireFlow AI Phase 2 Backend - Resume Management, Versions, Editor, Dashboard & Templates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "resumeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "versionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Auth - Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Jenkins\",\n  \"email\": \"sarah.jenkins@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Auth - Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah.jenkins@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Resume CRUD Operations",
      "item": [
        {
          "name": "Create Resume",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('resumeId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Full Stack Developer Resume\",\n  \"template\": \"modern\",\n  \"theme\": {\n    \"primaryColor\": \"#0B192C\",\n    \"secondaryColor\": \"#1E3E62\",\n    \"accentColor\": \"#3B82F6\",\n    \"font\": \"Inter\",\n    \"fontSize\": \"medium\",\n    \"layoutSpacing\": \"normal\"\n  },\n  \"resumeData\": {\n    \"personalInfo\": {\n      \"firstName\": \"Sarah\",\n      \"lastName\": \"Jenkins\",\n      \"email\": \"sarah.jenkins@example.com\",\n      \"phone\": \"+1 (555) 019-2834\",\n      \"location\": \"San Francisco, CA\",\n      \"jobTitle\": \"Senior Full Stack Engineer\",\n      \"website\": \"https://sarahjenkins.dev\",\n      \"linkedin\": \"https://linkedin.in/sarahjenkins\",\n      \"github\": \"https://github.com/sarahjenkins\"\n    },\n    \"summary\": \"Driven Senior Engineer with 7+ years of experience scaling cloud-native Node.js microservices.\",\n    \"skills\": [\n      { \"id\": \"s1\", \"name\": \"React.js\", \"category\": \"Frontend\", \"level\": \"Expert\" },\n      { \"id\": \"s2\", \"name\": \"Node.js\", \"category\": \"Backend\", \"level\": \"Expert\" },\n      { \"id\": \"s3\", \"name\": \"MongoDB\", \"category\": \"Database\", \"level\": \"Advanced\" }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": ["{{baseUrl}}"],
              "path": ["resumes"]
            }
          }
        },
        {
          "name": "Get My Resumes (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes?page=1&limit=10&search=&favorite=&archived=false&sortBy=lastEdited&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["resumes"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "favorite", "value": "" },
                { "key": "archived", "value": "false" },
                { "key": "sortBy", "value": "lastEdited" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Get Resume By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", "{{resumeId}}"]
            }
          }
        },
        {
          "name": "Update Resume",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lead Full Stack Engineer - 2026 Edition\",\n  \"visibility\": \"private\",\n  \"status\": \"published\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", "{{resumeId}}"]
            }
          }
        },
        {
          "name": "Duplicate Resume",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}/duplicate",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", "{{resumeId}}", "duplicate"]
            }
          }
        },
        {
          "name": "Toggle Favorite Resume",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}/favorite",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", "{{resumeId}}", "favorite"]
            }
          }
        },
        {
          "name": "Archive Resume",
          "request": {
