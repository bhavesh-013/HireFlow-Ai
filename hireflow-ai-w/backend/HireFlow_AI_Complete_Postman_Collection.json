							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/resumes?page=1&limit=10&sortBy=lastEdited&sortOrder=desc",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resumes"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" },
								{ "key": "sortBy", "value": "lastEdited" },
								{ "key": "sortOrder", "value": "desc" }
