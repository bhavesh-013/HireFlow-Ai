							"mode": "raw",
							"raw": "{\n  \"title\": \"Principal Software Architect Resume\",\n  \"template\": \"modern\",\n  \"resumeData\": {\n    \"personalInfo\": {\n      \"firstName\": \"Alex\",\n      \"lastName\": \"Mercer\",\n      \"email\": \"alex@hireflow.ai\",\n      \"jobTitle\": \"Principal Software Architect\"\n    },\n    \"skills\": [\n      { \"id\": \"sk_1\", \"category\": \"Engineering\", \"name\": \"System Architecture\", \"level\": \"Expert\" }\n    ]\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/resumes",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "resumes"]
						}
					}
				},
