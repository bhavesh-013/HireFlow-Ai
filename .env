# HireFlow AI — Environment Variables (local, untracked — see .gitignore)
#
# This file is gitignored. Never commit real secrets to source control.

# Frontend (Vite) — VITE_-prefixed vars are inlined into the client bundle.
# The Supabase anon key is designed to be public; access control is enforced
# by Row Level Security (RLS) policies on the database, not by keeping this
# key secret.
VITE_SUPABASE_URL="https://ffdvayjhtuatfsswhfwz.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZmZHZheWpodHVhdGZzc3doZnd6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4MTU1NTAsImV4cCI6MjEwMTM5MTU1MH0.rswSGy1uGs2KUASECjhoQTjD4O9jX4xkYvMF4dC5_RU"

# ─────────────────────────────────────────────────────────────────────────
# TRUE SECRETS — DO NOT put real values here. This file previously
# contained a live SUPABASE_SERVICE_ROLE_KEY and ANTHROPIC_API_KEY in
# plaintext; those have been removed as part of a security fix and MUST be
# rotated (regenerated) in the Supabase dashboard / Anthropic console since
# they were exposed in this file.
#
# The service-role key and Anthropic key are only ever needed server-side
# (Supabase Edge Functions), never in this frontend .env. Set them with:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<new-value>
#   supabase secrets set ANTHROPIC_API_KEY=<new-value>
# ─────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY="set-via-supabase-secrets-only"
ANTHROPIC_API_KEY="set-via-supabase-secrets-only"

# Leave unset in production. If set, this key is bundled into client-side
# JS and readable by anyone using the app — only use for local dev, never
# in a deployed build.
# VITE_ANTHROPIC_API_KEY=""
# VITE_CLAUDE_API_KEY=""
