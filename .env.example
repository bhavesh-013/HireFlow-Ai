# HireFlow AI — Environment Variables Example
# Copy this file to .env and fill in your actual values. Never commit .env.

# -------------------------------------------------------
# 1. Required — Supabase Frontend Configuration (Vite)
# -------------------------------------------------------
# Safe to expose client-side: access is enforced by RLS policies, not by
# keeping the anon key secret.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# -------------------------------------------------------
# Google OAuth Configuration (Configured in Supabase Dashboard & Google Cloud Console)
# -------------------------------------------------------
# Google Client ID and Secret are configured in:
# Supabase Console -> Authentication -> Providers -> Google
# Development Authorized Origin: http://localhost:5173
# Development Redirect URI: https://<your-supabase-project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID="configured-in-supabase-dashboard"
GOOGLE_CLIENT_SECRET="configured-in-supabase-dashboard"
GOOGLE_CALLBACK_URL="https://<your-supabase-project-ref>.supabase.co/auth/v1/callback"

# -------------------------------------------------------
# 2. Optional — Direct Google Gemini API Fallback (local dev only)
# -------------------------------------------------------
# WARNING: VITE_-prefixed vars are bundled into client-side JS and are
# readable by anyone using the app. Only set these for local development.
# Never set them in a deployed/production build — rely on the Supabase
# Edge Function tier (below) for production AI calls instead.
# Get your key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=""

# -------------------------------------------------------
# 3. Server-side only — Supabase Edge Functions Secrets
# -------------------------------------------------------
# These must NEVER be prefixed with VITE_ and must NEVER be read by
# frontend code. Set them via the Supabase CLI, not in this file:
#   supabase secrets set GEMINI_API_KEY=your-google-gemini-api-key
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Listed here only as documentation of what the Edge Functions expect.
GEMINI_API_KEY="set-via-supabase-secrets-only"
SUPABASE_SERVICE_ROLE_KEY="set-via-supabase-secrets-only"
